# =========================
# 基础容器与宿主机端口映射
# 这些端口用于 Docker 容器对外暴露到本机
# =========================

# MySQL root 密码，仅容器初始化和管理操作使用
MYSQL_ROOT_PASSWORD=inlinechat_root
# 默认业务数据库名
MYSQL_DATABASE=inlinechat
# MySQL 业务账号
MYSQL_USER=inlinechat
# MySQL 业务账号密码
MYSQL_PASSWORD=inlinechat
# MySQL 映射到宿主机的端口
MYSQL_HOST_PORT=8233
# Redis 映射到宿主机的端口
REDIS_HOST_PORT=8236
# etcd 映射到宿主机的端口
ETCD_HOST_PORT=8237
# Prometheus 映射到宿主机的端口
PROMETHEUS_HOST_PORT=9090
# Alertmanager 映射到宿主机的端口
ALERTMANAGER_HOST_PORT=9093
# Grafana 映射到宿主机的端口
GRAFANA_HOST_PORT=3000
# Blackbox Exporter 映射到宿主机的端口
BLACKBOX_EXPORTER_HOST_PORT=9115

# =========================
# 各服务监听端口
# 容器内部服务监听端口，由 docker-compose 注入
# =========================

# chat-service HTTP 端口
CHAT_HTTP_PORT=8202
# chat-service gRPC 端口
CHAT_GRPC_PORT=8212
# auth-service gRPC 端口
AUTH_GRPC_PORT=8211
# admin-service gRPC 端口
ADMIN_GRPC_PORT=8214
# realtime-service HTTP 端口
REALTIME_HTTP_PORT=8203
# gateway-service HTTP 端口，也是本地统一访问入口
GATEWAY_HTTP_PORT=8200
# auth-service HTTP 端口
AUTH_HTTP_PORT=8201
# admin-service HTTP 端口
ADMIN_HTTP_PORT=8204
# ai-service HTTP 端口
AI_HTTP_PORT=8205

# =========================
# 日志、业务策略与网关限流
# =========================

# chat-service 日志级别
CHAT_LOG_LEVEL=info
# 会话自动关闭阈值，单位秒
AUTO_CLOSE_AFTER_SEC=300
# 是否启用事件 Outbox 一致性机制
EVENT_OUTBOX_ENABLED=true
# Outbox 扫描轮询间隔，单位毫秒
EVENT_OUTBOX_POLL_INTERVAL_MS=5000
# Outbox 每批次处理的事件数量
EVENT_OUTBOX_BATCH_SIZE=100
# Outbox 单条事件最大重试次数
EVENT_OUTBOX_MAX_ATTEMPTS=8
# Outbox 首次重试基准退避时间，单位毫秒
EVENT_OUTBOX_RETRY_BASE_MS=500
# Outbox 最大重试退避时间，单位毫秒
EVENT_OUTBOX_RETRY_MAX_MS=15000
# Outbox 事件进入 processing 后的超时回收阈值，单位秒
EVENT_OUTBOX_PROCESSING_TIMEOUT_SEC=30
# 服务启动时是否自动回放 dead 状态事件
EVENT_OUTBOX_REPLAY_DEAD_ON_START=false
# 启动回放 dead 事件时的最大批量
EVENT_OUTBOX_REPLAY_DEAD_BATCH=200
# realtime-service 日志级别
REALTIME_LOG_LEVEL=info
# gateway-service 日志级别
GATEWAY_LOG_LEVEL=info
# auth-service 日志级别
AUTH_LOG_LEVEL=info
# admin-service 日志级别
ADMIN_LOG_LEVEL=info
# ai-service 日志级别
AI_LOG_LEVEL=info
# 网关生成或透传的请求 ID Header 名称
GATEWAY_REQUEST_ID_HEADER=X-Request-ID
# 登录接口每分钟限流次数
LOGIN_RATE_LIMIT_PER_MIN=60
# 登录接口瞬时突发上限
LOGIN_RATE_LIMIT_BURST=20
# 访客接口每分钟限流次数
VISITOR_RATE_LIMIT_PER_MIN=180
# 访客接口瞬时突发上限
VISITOR_RATE_LIMIT_BURST=60
# 客服接口每分钟限流次数
AGENT_RATE_LIMIT_PER_MIN=240
# 客服接口瞬时突发上限
AGENT_RATE_LIMIT_BURST=80
# 管理端接口每分钟限流次数
ADMIN_RATE_LIMIT_PER_MIN=120
# 管理端接口瞬时突发上限
ADMIN_RATE_LIMIT_BURST=40
# 限流 Key 在 Redis 中的保留时间，单位分钟
RATE_LIMIT_KEY_TTL_MINS=30
# 网关限流使用的 Redis 地址
RATE_LIMIT_REDIS_ADDR=redis:6379
# 网关限流使用的 Redis 密码
RATE_LIMIT_REDIS_PASSWORD=
# 网关限流使用的 Redis DB
RATE_LIMIT_REDIS_DB=0
# 网关限流 Key 前缀
RATE_LIMIT_REDIS_PREFIX=gateway:ratelimit
# 网关访问限流 Redis 的超时时间，单位毫秒
RATE_LIMIT_REDIS_TIMEOUT_MS=120

# =========================
# 数据库连接池与监控默认账号
# =========================

# MySQL 最大打开连接数
MYSQL_MAX_OPEN_CONNS=80
# MySQL 最大空闲连接数
MYSQL_MAX_IDLE_CONNS=20
# MySQL 单连接最大生命周期，单位秒
MYSQL_CONN_MAX_LIFETIME_SEC=900
# MySQL 空闲连接最大保留时间，单位秒
MYSQL_CONN_MAX_IDLE_TIME_SEC=300
# MySQL 查询默认超时，单位毫秒
MYSQL_QUERY_TIMEOUT_MS=1500
# Grafana 默认管理员账号
GRAFANA_ADMIN_USER=admin
# Grafana 默认管理员密码
GRAFANA_ADMIN_PASSWORD=admin

# =========================
# 各服务数据库连接串与迁移配置
# =========================

# chat-service MySQL DSN
CHAT_MYSQL_DSN=inlinechat:inlinechat@tcp(mysql:3306)/inlinechat?charset=utf8mb4&parseTime=True&loc=Local
# chat-service 数据库迁移连接串
CHAT_MYSQL_MIGRATE_URL=mysql://inlinechat:inlinechat@tcp(mysql:3306)/inlinechat?multiStatements=true&x-migrations-table=schema_migrations_chat
# auth-service MySQL DSN
AUTH_MYSQL_DSN=inlinechat:inlinechat@tcp(mysql:3306)/inlinechat?charset=utf8mb4&parseTime=True&loc=Local
# auth-service 数据库迁移连接串
AUTH_MYSQL_MIGRATE_URL=mysql://inlinechat:inlinechat@tcp(mysql:3306)/inlinechat?multiStatements=true&x-migrations-table=schema_migrations_auth
# admin-service MySQL DSN
ADMIN_MYSQL_DSN=inlinechat:inlinechat@tcp(mysql:3306)/inlinechat?charset=utf8mb4&parseTime=True&loc=Local
# admin-service 数据库迁移连接串
ADMIN_MYSQL_MIGRATE_URL=mysql://inlinechat:inlinechat@tcp(mysql:3306)/inlinechat?multiStatements=true&x-migrations-table=schema_migrations_admin

# =========================
# 鉴权与超级管理员初始化
# =========================

# JWT 签名密钥，生产环境必须替换
JWT_SECRET=change_me_to_a_long_random_secret
# JWT issuer
JWT_ISSUER=inlinechat-auth
# JWT 有效期
JWT_EXPIRE=12h
# bcrypt 计算成本
BCRYPT_COST=12
# 首次启动自动初始化的超级管理员邮箱
SUPER_ADMIN_EMAIL=superadmin@example.com
# 首次启动自动初始化的超级管理员密码
SUPER_ADMIN_PASSWORD=Sup3rAdmin#2026!
# 首次启动自动初始化的超级管理员显示名
SUPER_ADMIN_DISPLAY_NAME=超级管理员

# =========================
# Redis 与 WebSocket 基础配置
# =========================

# 业务 Redis 地址
REDIS_ADDR=redis:6379
# 业务 Redis 密码
REDIS_PASSWORD=
# 业务 Redis DB
REDIS_DB=0
# WebSocket 允许的来源，多个值用逗号分隔
WS_ALLOWED_ORIGINS=http://localhost:8200,http://127.0.0.1:8200

# =========================
# etcd 服务发现配置
# =========================

# etcd 地址列表，多个值用逗号分隔
ETCD_ENDPOINTS=etcd:2379
# etcd 连接超时，单位秒
ETCD_DIAL_TIMEOUT_SEC=5
# 服务注册租约 TTL，单位秒
ETCD_REGISTER_TTL_SEC=15
# etcd 服务发现前缀
DISCOVERY_PREFIX=/inlinechat/services

# =========================
# 服务命名
# 用于服务注册发现和内部调用
# =========================

# chat-service 注册名
CHAT_SERVICE_NAME=chat-service
# auth-service 注册名
AUTH_SERVICE_NAME=auth-service
# admin-service 注册名
ADMIN_SERVICE_NAME=admin-service
# realtime-service 注册名
REALTIME_SERVICE_NAME=realtime-service
# ai-service 注册名
AI_SERVICE_NAME=ai-service

# =========================
# 服务对外通告地址
# 注册到 etcd 后供其他服务发现与调用
# =========================

# chat-service 对外通告的 gRPC 地址
CHAT_SERVICE_ADVERTISE_GRPC_ENDPOINT=chat-service:8212
# auth-service 对外通告的 gRPC 地址
AUTH_SERVICE_ADVERTISE_GRPC_ENDPOINT=auth-service:8211
# admin-service 对外通告的 gRPC 地址
ADMIN_SERVICE_ADVERTISE_GRPC_ENDPOINT=admin-service:8214
# realtime-service 对外通告的 HTTP 地址
REALTIME_SERVICE_ADVERTISE_HTTP_ENDPOINT=http://realtime-service:8203
# ai-service 对外通告的 HTTP 地址
AI_SERVICE_ADVERTISE_HTTP_ENDPOINT=http://ai-service:8205

# =========================
# 服务间 gRPC 调用超时
# =========================

# chat 相关 gRPC 拨号超时，单位秒
CHAT_GRPC_DIAL_TIMEOUT_SEC=8
# chat 相关 gRPC 请求超时，单位秒
CHAT_GRPC_CALL_TIMEOUT_SEC=8
# 通用 gRPC 拨号超时，单位秒
GRPC_DIAL_TIMEOUT_SEC=8
# 通用 gRPC 请求超时，单位秒
GRPC_CALL_TIMEOUT_SEC=8
# ai-service 调 chat/admin 的 gRPC 拨号超时，单位秒
AI_GRPC_DIAL_TIMEOUT_SEC=8
# ai-service 调 chat/admin 的 gRPC 请求超时，单位秒
AI_GRPC_CALL_TIMEOUT_SEC=8

# =========================
# AI 服务配置
# 默认接宿主机上的 llama-server OpenAI-compatible 接口
# =========================

# 大模型接口基地址
AI_LLM_BASE_URL=http://host.docker.internal:8299/v1
# 大模型名称
AI_LLM_MODEL=Qwen3-4B-Q4_K_M
# 向量模型接口基地址
AI_EMBEDDING_BASE_URL=http://host.docker.internal:8298/v1
# 向量模型名称
AI_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
# 知识库文件路径
AI_KB_PATH=/app/docs/qinghe-home-customer-knowledge-base.md
# 向量检索召回条数
AI_RETRIEVE_TOP_K=5
# 向量检索最小相似度阈值，范围 0 到 1
AI_MIN_SIMILARITY=0.35
# AI 无法回答时的兜底回复
AI_UNKNOWN_REPLY=抱歉，这个问题我暂时无法根据现有资料准确确认，建议联系人工客服进一步核实。
# AI HTTP 调用超时，单位毫秒
AI_HTTP_TIMEOUT_MS=45000
# 是否跳过外部 LLM、Embedding、知识库的 readiness 检查
AI_DISABLE_EXTERNAL_READINESS=false
